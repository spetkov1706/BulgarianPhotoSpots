@model IEnumerable<BulgarianPhotoSpots.Models.PhotoSpot>

<h2>All Photo Spots (Admin)</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var spot in Model)
        {
            <tr>
                <td>@spot.Title</td>
                <td>@spot.Location</td>
                <td>@spot.Rating</td>
                <td>
                    <a asp-area=""
                       asp-controller="PhotoSpots"
                       asp-action="Edit"
                       asp-route-id="@spot.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-area=""
                       asp-controller="PhotoSpots"
                       asp-action="Delete"
                       asp-route-id="@spot.Id"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>