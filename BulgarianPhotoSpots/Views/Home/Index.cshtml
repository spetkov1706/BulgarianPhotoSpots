@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-dark rounded-3 text-white shadow-lg" 
     style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/uploads/hero-bg.png'); 
            background-size: cover; background-position: center; min-height: 450px; display: flex; align-items: center;">
    
    <div class="container-fluid py-5 text-center">
        <h1 class="display-4 fw-bold mb-3">Bulgarian Photo Spots</h1>
        <p class="fs-4 mb-5">Discover, share, and explore the most breathtaking photography locations across Bulgaria.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="PhotoSpots" asp-action="Index" class="btn btn-primary btn-lg px-5 shadow">Start Exploring</a>
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg px-5 ms-sm-3">Join the Community</a>
            }
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 py-5 row-cols-1 row-cols-lg-3 text-center">
        <div class="feature col">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center text-primary fs-2 mb-3">
                <i class="bi bi-camera"></i>
            </div>
            <h3 class="fs-4">Share Your Spots</h3>
            <p class="text-muted">Upload your favorite photography locations and help others find the perfect shot.</p>
        </div>
        <div class="feature col">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center text-primary fs-2 mb-3">
                <i class="bi bi-heart"></i>
            </div>
            <h3 class="fs-4">Save Favorites</h3>
            <p class="text-muted">Create a personal collection of spots you want to visit on your next trip.</p>
        </div>
        <div class="feature col">
            <div class="feature-icon d-inline-flex align-items-center justify-content-center text-primary fs-2 mb-3">
                <i class="bi bi-geo-alt"></i>
            </div>
            <h3 class="fs-4">Explore Regions</h3>
            <p class="text-muted">From high mountain peaks to ancient seaside towns - find them all here.</p>
        </div>
    </div>
</div>

<style>
    .feature-icon {
        width: 64px;
        height: 64px;
        background-color: rgba(13, 110, 253, 0.1);
        border-radius: 50%;
        transition: transform 0.3s ease;
    }
    .feature:hover .feature-icon {
        transform: scale(1.1);
        background-color: rgba(13, 110, 253, 0.2);
    }
</style>