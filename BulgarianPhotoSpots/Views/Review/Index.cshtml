@model List<BulgarianPhotoSpots.Models.Review>

<h1>Reviews</h1>

@foreach (var review in Model)
{
    <div>
        <p><strong>Author:</strong> @review.AuthorName</p>
        <p><strong>Comment:</strong> @review.Comment</p>
        <p><strong>Rating:</strong> @review.Rating</p>
        <p><strong>PhotoSpotId:</strong> @review.PhotoSpotId</p>
        <hr />

        <a href="/Review/Delete/@review.Id">Delete</a>

        <hr />
    </div>
}