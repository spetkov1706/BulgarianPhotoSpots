@model List<BulgarianPhotoSpots.Models.Review>

<h1>Reviews</h1>

<a href="/Review/Create">Add Review</a>

@foreach (var review in Model)
{
    <div>
        <p>@review.Comment</p>
        <p>Rating: @review.Rating</p>

        <a href="/Review/Delete/@review.Id">Delete</a>

        <hr />
    </div>
}