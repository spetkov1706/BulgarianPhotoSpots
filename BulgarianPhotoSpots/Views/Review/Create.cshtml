@model BulgarianPhotoSpots.ViewModels.ReviewViewModel

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PhotoSpotId" />

    <div asp-validation-summary="All" style="color:red"></div>

    <div>
        <label>Comment</label>
        <textarea asp-for="Comment"></textarea>
    </div>

    <div>
        <label>Rating</label>
        <input asp-for="Rating" type="number" />
    </div>

    <button type="submit">Add</button>

</form>