@using System.Security.Claims
@model BulgarianPhotoSpots.ViewModels.PhotoSpotListViewModel

@{
    ViewData["Title"] = "Photo Spots";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@{
    var favoriteIds = ViewBag.FavoriteIds as List<int>;
}

<h1>Photo Spots in Bulgaria</h1>

<h4>@Model.PageTitle</h4>
<p>Total Spots: @Model.TotalCount</p>

<form method="get" class="mb-3">

    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">

        <input type="text"
               name="searchTerm"
               value="@Model.SearchTerm"
               placeholder="Search..."
               class="form-control"
               style="width:200px;" />

        <select name="categoryId" class="form-control" style="width:150px;">
            <option value="">All</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id"
                        selected="@(category.Id == Model.CategoryId)">
                    @category.Name
                </option>
            }
        </select>

        <button type="submit" class="btn btn-dark">Search</button>

    </div>

    <div style="margin-top:10px;">
        <input type="text"
               name="location"
               value="@Context.Request.Query["location"]"
               placeholder="Filter by location..."
               class="form-control"
               style="width:300px;" />
    </div>

</form>

@if (User.Identity.IsAuthenticated)
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        Add New Photo Spot
    </a>
}
else
{
    <p style="color:gray; margin-bottom:15px;">
        🔒 You must be logged in to add photo spots.
    </p>

    <a asp-area="Identity"
           asp-page="/Account/Login"
           class="btn btn-outline-primary mb-3">
        Login
    </a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Location</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var spot in Model.PhotoSpots)
        {
            <tr>
                <td>@spot.Title</td>
                <td>@spot.Description</td>
                <td>@spot.Location</td>
                <td>@spot.Rating</td>
                <td>
                    <a asp-action="Details" asp-route-id="@spot.Id" class="btn btn-success btn-sm">Details</a>

                    @if (User.Identity.IsAuthenticated && spot.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                    {
                        <a asp-action="Edit" asp-route-id="@spot.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@spot.Id" class="btn btn-danger btn-sm">Delete</a>
                    }

                    <a asp-controller="Favorite"
                           asp-action="Toggle"
                           asp-route-photoSpotId="@spot.Id">
                        @(favoriteIds != null && favoriteIds.Contains(spot.Id) ? "❤️" : "🤍")
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">

    @if (Model.TotalPages > 1)
    {
        for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-location="@Context.Request.Query["location"]"
                   class="btn @(i == Model.CurrentPage ? "btn-dark" : "btn-outline-dark") me-1">
                @i
            </a>
        }
    }

</div>