@using System.Security.Claims
@model BulgarianPhotoSpots.ViewModels.PhotoSpotListViewModel

@{
    ViewData["Title"] = "Photo Spots";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@{
    var favoriteIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
}

<h1>Photo Spots in Bulgaria</h1>
<h4>@Model.PageTitle</h4>
<p>Total Spots: @Model.TotalCount</p>

<form method="get" class="mb-3">
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <input type="text"
               name="searchTerm"
               value="@Model.SearchTerm"
               placeholder="Search..."
               class="form-control"
               style="width:200px;" />

        <select name="categoryId" class="form-control" style="width:150px;">
            <option value="">All</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id"
                        selected="@(category.Id == Model.CategoryId)">
                    @category.Name
                </option>
            }
        </select>

        <button type="submit" class="btn btn-dark">Search</button>
    </div>

    <div style="margin-top:10px;">
        <input type="text"
               name="location"
               value="@Context.Request.Query["location"]"
               placeholder="Filter by location..."
               class="form-control"
               style="width:300px;" />
    </div>
</form>

@if (User.Identity.IsAuthenticated)
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        Add New Photo Spot
    </a>
}
else
{
    <p style="color:gray; margin-bottom:15px;">
        🔒 You must be logged in to add photo spots.
    </p>

    <a asp-area="Identity"
           asp-page="/Account/Login"
           class="btn btn-outline-primary mb-3">
        Login
    </a>
}

<div class="container mt-4">
    <div class="row">
        @foreach (var item in Model.PhotoSpots)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                         class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted">
                            <i class="bi bi-geo-alt"></i> @item.Location
                        </p>
                        <p class="card-text flex-grow-1">
                            @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="text-warning">
                                <i class="bi bi-star-fill"></i> @item.Rating/10
                            </div>
    
                            <div class="d-flex align-items-center">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    var isFavorite = favoriteIds != null && favoriteIds.Contains(item.Id);
            
                                    <form asp-controller="Favorite" asp-action="ToggleFavorite" method="post" class="me-2">
                                        <input type="hidden" name="photoSpotId" value="@item.Id" />
                                        <button type="submit" class="btn btn-link p-0 border-0 shadow-none">
                                            <i class="bi @(isFavorite ? "bi-heart-fill text-danger" : "bi-heart text-muted")" style="font-size: 1.5rem;"></i>
                                        </button>
                                    </form>
                                }

                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                    @if (User.IsInRole("Admin") || item.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    }
                                </div>
                            </div>
                        </div>
                     </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    @if (Model.TotalPages > 1)
    {
        for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-location="@Context.Request.Query["location"]"
                   class="btn @(i == Model.CurrentPage ? "btn-dark" : "btn-outline-dark") me-1">
                @i
            </a>
        }
    }
</div>