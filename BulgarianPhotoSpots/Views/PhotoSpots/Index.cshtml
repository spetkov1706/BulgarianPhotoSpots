@model BulgarianPhotoSpots.ViewModels.PhotoSpotListViewModel

@{
    ViewData["Title"] = "Photo Spots";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@{
    var favoriteIds = ViewBag.FavoriteIds as List<int>;
}

<h1>Photo Spots in Bulgaria</h1>

<h4>@Model.PageTitle</h4>
<p>Total Spots: @Model.TotalCount</p>

<form method="get" class="mb-3">

    <input type="text" name="searchTerm"
           placeholder="Search..."
           value="@Context.Request.Query["searchTerm"]"
           class="form-control mb-2" style="width:300px;" />

    <input type="text" name="location"
           placeholder="Filter by location..."
           value="@Context.Request.Query["location"]"
           class="form-control mb-2" style="width:300px;" />

    <button type="submit" class="btn btn-primary">Search</button>

</form>

@if (User.Identity.IsAuthenticated)
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        Add New Photo Spot
    </a>
}
else
{
    <p style="color:gray; margin-bottom:15px;">
        🔒 You must be logged in to add photo spots.
    </p>

    <a asp-area="Identity"
           asp-page="/Account/Login"
           class="btn btn-outline-primary mb-3">
        Login
    </a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Location</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var spot in Model.PhotoSpots)
        {
            <tr>
                <td>@spot.Title</td>
                <td>@spot.Description</td>
                <td>@spot.Location</td>
                <td>@spot.Rating</td>
                <td>
                    <a asp-action="Details" asp-route-id="@spot.Id"
                       class="btn btn-info btn-sm">Details</a>
                        
                    <a asp-action="Edit" asp-route-id="@spot.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete" asp-route-id="@spot.Id"
                       class="btn btn-danger btn-sm">Delete</a>

                    <a asp-controller="Favorite"
                           asp-action="Toggle"
                           asp-route-photoSpotId="@spot.Id">

                        @(favoriteIds != null && favoriteIds.Contains(spot.Id) ? "❤️" : "🤍")

                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>