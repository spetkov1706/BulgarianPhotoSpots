@model IEnumerable<BulgarianPhotoSpots.Models.PhotoSpot>

@{
    ViewData["Title"] = "Photo Spots";
}

<h1>Photo Spots in Bulgaria</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Photo Spot</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Location</th>
            <th>Rating</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var spot in Model)
        {
            <tr>
                <td>@spot.Title</td>
                <td>@spot.Description</td>
                <td>@spot.Location</td>
                <td>@spot.Rating</td>
            </tr>
        }
    </tbody>
</table>
