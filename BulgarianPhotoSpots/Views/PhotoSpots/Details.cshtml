@using System.Security.Claims
@model BulgarianPhotoSpots.Models.PhotoSpot

<h2>Photo Spot Details</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Rating:</strong> @Model.Rating</p>
    </div>
</div>

<div class="mt-3 mb-3">
    <a asp-controller="Review"
           asp-action="Create"
           asp-route-photoSpotId="@Model.Id"
           class="btn btn-primary">
        Add Review
    </a>

    @if (User.Identity.IsAuthenticated &&
        Model.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
    {
        <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger ms-2">
            Delete
        </a>
    }
</div>

<h4 class="mt-4">Reviews</h4>

@{
    var avgRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating)
        : 0;
}

@if (Model.Reviews != null && Model.Reviews.Any())
{
    <p>
        <strong>Average Rating:</strong>
        @avgRating.ToString("0.0")

        @for (int i = 1; i <= 5; i++)
        {
            if (i <= Math.Round(avgRating / 2))
            {
                <span style="color:gold;">★</span>
            }
            else
            {
                <span style="color:lightgray;">★</span>
            }
        }
    </p>

    @foreach (var review in Model.Reviews)
    {
        <div class="card mt-2">
            <div class="card-body">

                <div>
                    <strong>@review.AuthorName</strong>
                    <small class="text-muted ms-2">
                        @review.CreatedOn.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>

                <p>@review.Comment</p>

                <p>Rating: @review.Rating</p>

            </div>
        </div>
    }
}
else
{
    <p>No reviews yet.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>

@section Scripts {
    <script>
        console.log("Details page loaded");
    </script>
}