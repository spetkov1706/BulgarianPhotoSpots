@using System.Security.Claims
@model BulgarianPhotoSpots.Models.PhotoSpot

<h2>Photo Spot Details</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Rating:</strong> @Model.Rating</p>
    </div>
</div>

<div class="mt-3 mb-3">
    @if (User.Identity.IsAuthenticated)
    {
        <a asp-controller="Review" asp-action="Create" asp-route-photoSpotId="@Model.Id" class="btn btn-primary">
            Add Review
        </a>
    }
    else
    {
        <p><em>Please <a asp-area="Identity" asp-page="/Account/Login">login</a> to write a review.</em></p>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="mt-3 mb-3">
            <a asp-controller="PhotoSpots" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete (Admin Only)</a>
        </div>
    }
</div>

<h4 class="mt-4">Reviews</h4>

@{
    var avgRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating)
        : 0;
}

@if (Model.Reviews != null && Model.Reviews.Any())
{
    <p>
        <strong>Average Rating:</strong>
        @avgRating.ToString("0.0")

        @for (int i = 1; i <= 5; i++)
        {
            if (i <= Math.Round(avgRating / 2))
            {
                <span style="color:gold;">★</span>
            }
            else
            {
                <span style="color:lightgray;">★</span>
            }
        }
    </p>

    @foreach (var review in Model.Reviews)
    {
        <div class="card mt-2">
            <div class="card-body">

                <div>
                    <strong>@review.UserName</strong>
                    <small class="text-muted ms-2">
                        @review.CreatedOn.ToString("dd.MM.yyyy HH:mm")
                    </small>
                    @if (review.EditedOn != null)
                    {
                        <small class="text-muted ms-2">
                            (edited @review.EditedOn.Value.ToString("dd.MM.yyyy HH:mm"))
                        </small>
                    }
                </div>

                <p>@review.Comment</p>

                <p>Rating: @review.Rating</p>

                @if (User.Identity.IsAuthenticated && (review.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier) || User.IsInRole("Admin")))
                {
                    <div class="mt-2">
                        <a asp-controller="Review" asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-controller="Review" asp-action="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <p>No reviews yet.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>

@section Scripts {
    <script>
        console.log("Details page loaded");
    </script>
}