@using System.Security.Claims
@model BulgarianPhotoSpots.Models.PhotoSpot

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 mb-5">
    <div class="position-relative rounded-5 overflow-hidden shadow-lg mb-5" style="height: 500px;">
        <img src="@Model.ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="@Model.Title">
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.7));"></div>
        
        <div class="position-absolute bottom-0 start-0 p-5 text-white">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-white-50 text-decoration-none">Explore</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">@Model.Category?.Name</li>
                </ol>
            </nav>
            <h1 class="display-3 fw-bold">@Model.Title</h1>
            <p class="fs-5 opacity-75"><i class="bi bi-geo-alt-fill me-2"></i>@Model.Location</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">About this location</h3>
                    <span class="badge bg-light text-primary border px-3 py-2 rounded-pill">
                        <i class="bi bi-tag-fill me-1"></i> @Model.Category?.Name
                    </span>
                </div>
                <p class="lead text-muted" style="line-height: 1.8;">
                    @Model.Description
                </p>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="d-flex align-items-center p-3 bg-white rounded-4 shadow-sm border border-light">
                        <div class="flex-shrink-0 bg-primary bg-opacity-10 rounded-circle p-3 me-3 text-primary">
                            <i class="bi bi-calendar-event fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Best time to visit</small>
                            <span class="fw-bold text-dark">All year round</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center p-3 bg-white rounded-4 shadow-sm border border-light">
                        <div class="flex-shrink-0 bg-success bg-opacity-10 rounded-circle p-3 me-3 text-success">
                            <i class="bi bi-camera fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Photography level</small>
                            <span class="fw-bold text-dark">Beginner to Pro</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px;">
                <h5 class="fw-bold mb-4 text-center">Actions</h5>
                <div class="d-grid gap-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            <i class="bi bi-pencil-square me-2"></i>Edit Spot
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-dark btn-lg rounded-pill">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                </div>
                
                <div class="mt-4 pt-4 border-top text-center">
                    <p class="small text-muted mb-0">Shared with the community</p>
                    <div class="text-warning mt-1">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(255,255,255,0.5);
    }
    .rounded-5 { border-radius: 2.5rem !important; }
    .rounded-4 { border-radius: 1.5rem !important; }
    
    .container {
        animation: slideUp 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .btn { transition: all 0.3s ease; }
    .btn:hover { transform: translateY(-2px); }
</style>