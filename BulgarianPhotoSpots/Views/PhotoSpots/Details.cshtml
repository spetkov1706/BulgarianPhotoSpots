@using System.Security.Claims
@model BulgarianPhotoSpots.Models.PhotoSpot

<h2>Photo Spot Details</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!string.IsNullOrEmpty(ViewBag.Tab))
{
    <p><strong>Selected Tab:</strong> @ViewBag.Tab</p>
}

<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Rating:</strong> @Model.Rating</p>
    </div>
</div>

<div class="mt-3 mb-3">
    <a asp-controller="Review"
           asp-action="Create"
           asp-route-photoSpotId="@Model.Id"
           class="btn btn-primary">
        Add Review
    </a>
</div>

<h4 class="mt-4">Reviews</h4>

@{
    var avgRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating)
        : 0;
}

@if (Model.Reviews != null && Model.Reviews.Any())
{
    <p>
        <strong>Average Rating:</strong>
        @avgRating.ToString("0.0")

        @for (int i = 1; i <= 5; i++)
        {
            if (i <= Math.Round(avgRating / 2))
            {
                <span style="color:gold;">★</span>
            }
            else
            {
                <span style="color:lightgray;">★</span>
            }
        }
    </p>

    foreach (var review in Model.Reviews)
    {
        <div class="border p-2 mb-2 rounded">

            <p>
                <strong>Rating:</strong> @review.Rating

                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(review.Rating / 2.0))
                    {
                        <span style="color:gold;">★</span>
                    }
                    else
                    {
                        <span style="color:lightgray;">★</span>
                    }
                }
            </p>

            <p>
                @review.Comment

                @if (review.EditedOn != null)
                {
                    <span class="text-muted">(edited)</span>
                }
            </p>

            @if (review.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
            {
                <a asp-controller="Review"
                       asp-action="Edit"
                       asp-route-id="@review.Id"
                       class="btn btn-warning btn-sm me-2">
                    Edit
                </a>

                <form asp-controller="Review"
                      asp-action="DeleteConfirmed"
                      method="post"
                      style="display:inline;">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@review.Id" />

                    <button type="submit"
                            class="btn btn-danger btn-sm"
                            onclick="return confirm('Are you sure you want to delete this review?')">
                        Delete
                    </button>
                </form>
            }
        </div>
    }
}
else
{
    <p>No reviews yet.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>