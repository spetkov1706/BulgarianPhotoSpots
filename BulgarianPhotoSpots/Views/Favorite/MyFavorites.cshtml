@model List<BulgarianPhotoSpots.Core.Models.Favorite>

@{
    ViewData["Title"] = "My Favorites";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-4">My <span class="text-danger"><i class="bi bi-heart-fill"></i> Favorites</span></h1>
        <p class="text-muted">Your personal collection of breathtaking spots in Bulgaria.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded-4 bg-white border">
            <div class="mb-3">
                <i class="bi bi-camera2 display-1 text-light"></i>
            </div>
            <h3 class="mt-3 text-muted">Your gallery is empty</h3>
            <p class="text-muted">Start exploring and save your favorite locations!</p>
            <a asp-controller="PhotoSpots" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm">Explore Spots</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden favorite-card">
                        <div class="row g-0 align-items-center">
                            <div class="col-md-4 position-relative" style="height: 220px;">
                                <img src="@item.PhotoSpot.ImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover;" alt="@item.PhotoSpot.Title">
                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge bg-white text-dark rounded-pill shadow-sm">
                                        <i class="bi bi-star-fill text-warning me-1"></i> @item.PhotoSpot.Rating
                                    </span>
                                </div>
                            </div>
                            
                            <div class="col-md-8 p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h3 class="fw-bold mb-1">@item.PhotoSpot.Title</h3>
                                        <p class="text-primary mb-3"><i class="bi bi-geo-alt-fill me-1"></i> @item.PhotoSpot.Location</p>
                                    </div>
                                    
                                    <form asp-action="Remove" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn-favorite-remove" title="Remove from favorites">
                                            <i class="bi bi-heart-fill heart-full"></i>
                                            <i class="bi bi-heart heart-empty"></i>
                                        </button>
                                    </form>
                                </div>
                                
                                <p class="text-muted mb-4 text-truncate-2">@item.PhotoSpot.Description</p>
                                
                                <div class="d-flex gap-2">
                                    <a asp-controller="PhotoSpots" asp-action="Details" asp-route-id="@item.PhotoSpotId" class="btn btn-dark rounded-pill px-4 shadow-sm">
                                        View Details
                                    </a>
                                    <a asp-controller="Review" asp-action="Create" asp-route-photoSpotId="@item.PhotoSpotId" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
                                        Leave Review
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    body { background-color: #f4f7f6; }

    .favorite-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .favorite-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.08) !important;
    }

    /* Стилизация на сърцето */
    .btn-favorite-remove {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        font-size: 1.5rem;
        position: relative;
        color: #dc3545; 
        transition: transform 0.2s ease;
    }

    .btn-favorite-remove .heart-empty {
        display: none;
    }

    .btn-favorite-remove:hover .heart-full {
        display: none;
    }

    .btn-favorite-remove:hover .heart-empty {
        display: inline-block;
    }

    .btn-favorite-remove:hover {
        transform: scale(1.2);
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>