@model BulgarianPhotoSpots.Core.Models.UserProfile

<h2>Create Profile</h2>

<form asp-action="Create" method="post">
    <div>
        <label>Bio</label>
        <input asp-for="Bio" />
    </div>

    <div>
        <label>Profile Picture URL</label>
        <input asp-for="ProfilePictureUrl" />
    </div>

    <button type="submit">Save</button>
</form>