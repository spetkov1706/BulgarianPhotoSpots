@model BulgarianPhotoSpots.Core.Models.UserProfile

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden bg-white">
                <div class="card-header bg-primary p-4 text-center text-white border-0">
                    <i class="bi bi-person-gear display-4"></i>
                    <h2 class="fw-bold mt-2 mb-0">Edit Profile</h2>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="ProfilePictureUrl" />

                        <div class="text-center mb-4">
                            <label class="form-label d-block fw-bold mb-3">Current Profile Picture</label>
                            <div class="position-relative d-inline-block">
                                <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "/images/default-avatar.png" : Model.ProfilePictureUrl)"
                                     class="rounded-circle shadow-sm border border-4 border-white"
                                     style="width: 150px; height: 150px; object-fit: cover;"
                                     alt="Preview">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-upload me-1"></i> Change Profile Picture
                            </label>
                            <input type="file" name="ImageFile" id="fileInput" class="form-control rounded-pill px-4" accept="image/*" />
                            <small class="text-muted ps-3">Leave empty to keep current photo</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Bio" class="form-label fw-bold">
                                <i class="bi bi-chat-quote me-1"></i> About Me
                            </label>
                            <textarea asp-for="Bio" class="form-control rounded-4 px-4 py-3" rows="4"
                                      placeholder="Tell the community about yourself..."></textarea>
                        </div>

                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm py-3 fw-bold">
                                <i class="bi bi-check-lg me-2"></i> Save Changes
                            </button>
                            <a asp-action="MyProfile" class="btn btn-outline-secondary rounded-pill py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('fileInput').addEventListener('change', function (e) {
            const reader = new FileReader();
            reader.onload = function (event) {
                document.getElementById('imagePreview').src = event.target.result;
            }
            if (e.target.files[0]) {
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}