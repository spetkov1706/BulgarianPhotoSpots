@model IEnumerable<Category>
@using BulgarianPhotoSpots.Models

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">Explore Destinations</h1>
        <p class="lead text-muted">Select a category to discover the best spots in Bulgaria</p>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success shadow-sm mt-2">
                <i class="bi bi-plus-lg"></i> Add New Category
            </a>
        }
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <a asp-controller="PhotoSpots" asp-action="Index" asp-route-categoryId="@item.Id" class="text-decoration-none">
                    <div class="card category-hero-card border-0 shadow-lg overflow-hidden text-white">
                        @{
                            var bgImg = !string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/uploads/category-default.jpg";
                            
                            if (string.IsNullOrEmpty(item.ImageUrl))
                            {
                                if (item.Name == "Mountains" || item.Name == "Планини") bgImg = "/uploads/mountain_category.png";
                                else if (item.Name == "Sea" || item.Name == "Море") bgImg = "/uploads/sea_category.png";
                                else if (item.Name == "City" || item.Name == "Град") bgImg = "/uploads/city_category.png";
                            }
                        }
                        
                        <div class="category-bg-img" style="background-image: url('@bgImg');"></div>
                        <div class="card-img-overlay d-flex flex-column justify-content-end align-items-center pb-4">
                            <h2 class="fw-bold mb-0 category-title">@item.Name</h2>
                            <div class="category-divider my-2"></div>
                            <span class="btn btn-sm btn-light rounded-pill px-4 fw-bold shadow-sm view-btn">Explore</span>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="mt-3 d-flex gap-2 admin-badge-container">
                                    <span class="badge bg-dark bg-opacity-75 p-2 rounded-3 admin-link" onclick="event.preventDefault(); window.location.href='@Url.Action("Edit", new { id = item.Id })'">
                                        <i class="bi bi-pencil"></i>
                                    </span>
                                    <span class="badge bg-danger bg-opacity-75 p-2 rounded-3 admin-link" onclick="event.preventDefault(); window.location.href='@Url.Action("Delete", new { id = item.Id })'">
                                        <i class="bi bi-trash"></i>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .category-hero-card {
        height: 350px;
        border-radius: 25px;
        position: relative;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .category-bg-img {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background-size: cover;
        background-position: center;
        transition: transform 0.6s ease;
        z-index: 1;
    }

    .category-hero-card::after {
        content: "";
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
        z-index: 2;
    }

    .card-img-overlay { z-index: 3; }

    .category-hero-card:hover {
        transform: scale(1.03);
    }

    .category-hero-card:hover .category-bg-img {
        transform: scale(1.1);
    }

    .category-title {
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .category-divider {
        width: 40px;
        height: 3px;
        background-color: #0d6efd;
        border-radius: 2px;
        transition: width 0.3s ease;
    }

    .category-hero-card:hover .category-divider {
        width: 80px;
    }

    .admin-link {
        cursor: pointer;
        transition: transform 0.2s;
    }
    .admin-link:hover {
        transform: scale(1.2);
    }
</style>